# 健康大數據 App — 環境變數範本
# 複製為 .env 後填值。docker compose 會覆寫 PG_HOST / PG_PORT / REDIS_URL 指向容器。

APP_ENV=dev

# --- PostgreSQL ---
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DB=healthapp
PG_SUPERUSER=postgres
PG_SUPERPASS=change-me-super

# 各 DB 角色密碼（migration 建立角色時使用；角色定義見 docs/DECISIONS.md）
IDN_APP_PASSWORD=change-me-idn-app
IDN_USER_SCOPED_PASSWORD=change-me-idn-user
IDN_SITE_SCOPED_PASSWORD=change-me-idn-site
ANON_READER_PASSWORD=change-me-anon-reader
ANON_WRITER_PASSWORD=change-me-anon-writer
AUDIT_WRITER_PASSWORD=change-me-audit

# --- 事件匯流 ---
REDIS_URL=redis://127.0.0.1:56379/0
# redis | memory（memory = 進程內 fakeredis，只供測試／無 Redis 時示範，日誌標 [MOCK]）
EVENT_BUS=redis

# --- 身分驗證（自建簡版，介面留 OIDC） ---
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
JWT_TTL_MINUTES=480

# --- 應用層加密（AES-GCM，32 bytes，urlsafe base64） ---
# 產生：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
# 身分證字號雜湊用 pepper（HMAC-SHA256）
NATIONAL_ID_PEPPER=change-me-pepper

# --- LLM（M4 起使用） ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- 外部資料（未設定即用 adapters/mocks，日誌標 [MOCK]） ---
CWA_API_KEY=
MOENV_API_KEY=
GOOGLE_PLACES_API_KEY=
# JSON：{"place_id": "N01", ...}（輿情）／{"M01": "place_id", ...}（商家評分，SPEC §17.2）
PLACES_VILLAGES=
PLACES_MERCHANTS=
# JSON 陣列：公開活動公告的 RSS／Atom 網址（還要列入 pub.source_whitelist 的 event_notice）
EVENT_FEEDS=
